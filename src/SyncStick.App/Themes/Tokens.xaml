<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: warm paper, ink, signal orange. -->
    <Color x:Key="PaperColor">#F3F0E7</Color>
    <Color x:Key="SurfaceColor">#FCFBF6</Color>
    <Color x:Key="SurfaceAltColor">#EBE6DA</Color>
    <Color x:Key="SurfaceHoverColor">#F7F3E9</Color>
    <Color x:Key="InkColor">#17211C</Color>
    <Color x:Key="InkSoftColor">#5E665F</Color>
    <Color x:Key="InkFaintColor">#6F766C</Color>
    <Color x:Key="LineColor">#DED7C7</Color>
    <Color x:Key="LineStrongColor">#CBC3B1</Color>
    <Color x:Key="AccentColor">#E8552D</Color>
    <Color x:Key="AccentDeepColor">#C94320</Color>
    <Color x:Key="AccentSoftColor">#FBE4DA</Color>
    <Color x:Key="SuccessColor">#2E7D5B</Color>
    <Color x:Key="SuccessSoftColor">#E1EEE5</Color>
    <Color x:Key="WarningColor">#A96914</Color>
    <Color x:Key="WarningSoftColor">#F6EAD4</Color>
    <Color x:Key="DangerColor">#B3372C</Color>
    <Color x:Key="DangerSoftColor">#F8E3DF</Color>
    <Color x:Key="HeroColor">#17211C</Color>
    <Color x:Key="HeroLineColor">#334038</Color>
    <Color x:Key="HeroMutedColor">#A7B2A7</Color>
    <Color x:Key="CreamColor">#F5F1E6</Color>
    <Color x:Key="ToggleOffColor">#D8D2C4</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaintColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="HeroBrush" Color="{StaticResource HeroColor}" />
    <SolidColorBrush x:Key="HeroLineBrush" Color="{StaticResource HeroLineColor}" />
    <SolidColorBrush x:Key="HeroMutedBrush" Color="{StaticResource HeroMutedColor}" />
    <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource ToggleOffColor}" />

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="22"
                      ShadowDepth="5"
                      Direction="270"
                      Opacity="0.07"
                      Color="#17211C" />
    <DropShadowEffect x:Key="LiftedShadow"
                      BlurRadius="34"
                      ShadowDepth="10"
                      Direction="270"
                      Opacity="0.11"
                      Color="#17211C" />
    <DropShadowEffect x:Key="TinyShadow"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Direction="270"
                      Opacity="0.16"
                      Color="#17211C" />

    <DrawingBrush x:Key="HeroDotGrid"
                  TileMode="Tile"
                  Viewport="0,0,20,20"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#12FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
