<Window x:Class="SyncStick.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SyncStick.App.Views"
        Title="SyncStick · U 盘自动同步"
        Width="1240"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource InkBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshDevicesCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Border x:Name="AccentBar"
                                        Width="3"
                                        Height="16"
                                        Margin="-1,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame"
            Background="{StaticResource PaperBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== titlebar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Background="{StaticResource PaperBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.RowSpan="2"
                        VerticalAlignment="Bottom"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,1" />

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="26"
                            Height="26"
                            Background="{StaticResource InkBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Sync}"
                                  Stroke="{StaticResource CreamBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.7"
                                  Stretch="Uniform" />
                            <Ellipse Width="3"
                                     Height="3"
                                     Margin="15,6,0,0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Text="SyncStick" />
                    <Border Width="1"
                            Height="12"
                            Margin="10,0"
                            Background="{StaticResource LineStrongBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="9.5"
                               Foreground="{StaticResource InkFaintBrush}"
                               Text="U 盘自动同步" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="8.5"
                               Foreground="{StaticResource InkFaintBrush}"
                               Text="LOCAL ONLY" />
                    <Button Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="最小化">
                        <Path Width="12"
                              Height="12"
                              Data="{StaticResource Icon.Minimize}"
                              Stroke="{StaticResource InkSoftBrush}"
                              StrokeEndLineCap="Round"
                              StrokeThickness="1.6"
                              Stretch="Uniform" />
                    </Button>
                    <Button Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="最大化">
                        <Path x:Name="MaximizeIcon"
                              Width="12"
                              Height="12"
                              Data="{StaticResource Icon.Maximize}"
                              Stroke="{StaticResource InkSoftBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.4"
                              Stretch="Uniform" />
                    </Button>
                    <Button Click="OnCloseClick"
                            AutomationProperties.Name="关闭"
                            Style="{StaticResource CloseCaptionButton}"
                            ToolTip="关闭">
                        <Path Width="12"
                              Height="12"
                              Data="{StaticResource Icon.Close}"
                              Stroke="{StaticResource InkSoftBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.6"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================== sidebar -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,24,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Margin="11,0,0,9"
                                   Style="{StaticResource Text.Overline}"
                                   Text="WORKSPACE / 工作区" />
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,1"
                                            AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}"
                                            Style="{StaticResource NavButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Width="17"
                                                  Height="17"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Data="{Binding Icon}"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{StaticResource InkFaintBrush}" />
                                                        <Setter Property="StrokeThickness" Value="1.55" />
                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                                        <Setter Property="StrokeLineJoin" Value="Round" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Text="{Binding Title}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="2"
                                                    MinWidth="20"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SurfaceHoverBrush}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           Text="{Binding Badge}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Padding="13,12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource InkFaintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoSyncEnabled}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Text="自动同步" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="{Binding AutoSyncStateText}" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="自动同步" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="插入目标 U 盘后自动开始同步" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           LineHeight="15"
                                           Text="关闭后，仍可在总览手动同步。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="2,12,0,0" Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Shield}"
                                  Stroke="{StaticResource InkFaintBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="8.5"
                                       Foreground="{StaticResource InkFaintBrush}"
                                       Text="本机运行 · 不上传文件" />
                        </StackPanel>
                        <TextBlock Margin="2,5,0,0"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="8"
                                   Foreground="{StaticResource InkFaintBrush}"
                                   Text="{Binding FooterVersionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====================================================== content -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource PaperBrush}">
                <Grid x:Name="PageHost" Opacity="1">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Grid.RenderTransform>

                    <views:DashboardView x:Name="DashboardPage" Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVis}}" />
                    <views:SourcesView x:Name="SourcesPage" Visibility="{Binding IsSourcesPage, Converter={StaticResource BoolToVis}}" />
                    <views:DevicesView x:Name="DevicesPage" Visibility="{Binding IsDevicesPage, Converter={StaticResource BoolToVis}}" />
                    <views:ActivityView x:Name="ActivityPage" Visibility="{Binding IsActivityPage, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView x:Name="SettingsPage" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <Border x:Name="ToastHost"
                        Margin="24,0,24,24"
                        Padding="15,11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource InkBrush}"
                        CornerRadius="12"
                        Effect="{StaticResource LiftedShadow}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="10" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                CornerRadius="9">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFF9F2"
                                       Text="{Binding ToastIconGlyph}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,4,0"
                                   MaxWidth="600"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{StaticResource CreamBrush}"
                                   Text="{Binding ToastMessage}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
