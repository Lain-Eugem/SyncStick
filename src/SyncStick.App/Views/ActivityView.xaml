<UserControl x:Class="SyncStick.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{StaticResource Font.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <Grid MaxWidth="1080"
              Margin="32,24,30,30"
              HorizontalAlignment="Stretch">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="ACTIVITY / 活动记录" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Text.Display}"
                                   Text="每一次写入，都有迹可循" />
                        <TextBlock MaxWidth="620"
                                   Margin="0,7,0,0"
                                   Style="{StaticResource Text.Body}"
                                   Text="这里保留最近 60 次同步的结果、文件数量、体积和用时。记录只存在本机。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="24,0,0,0"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <Button Command="{Binding ClearActivitiesCommand}"
                                Content="清空记录"
                                IsEnabled="{Binding HasActivities}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,2,20,0">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="SAVED RUNS / 记录数" />
                        <TextBlock Margin="0,5,0,0"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActivityTotalRuns}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
                    <StackPanel Grid.Column="2" Margin="24,2,20,0">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="SUCCESS RATE / 成功率" />
                        <TextBlock Margin="0,5,0,0"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActivitySuccessRate}" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{StaticResource LineBrush}" />
                    <StackPanel Grid.Column="4" Margin="24,2,0,0">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="TOTAL WRITTEN / 累计写入" />
                        <TextBlock Margin="0,5,0,0"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActivityBytesTotal}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,24,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.H3}" Text="同步历史" />
                        <TextBlock Margin="9,2,0,0"
                                   Style="{StaticResource Text.Overline}"
                                   Text="{Binding ActivityCountText}" />
                    </StackPanel>
                </Grid>

                <Border Padding="34,30"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding HasActivities, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="58"
                                Height="58"
                                Margin="0,6,0,0"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="17">
                            <Path Width="25"
                                  Height="25"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Clock}"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="0,15,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.H2}"
                                   Text="还没有同步记录" />
                        <TextBlock Margin="0,6,0,6"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Body}"
                                   Text="插上目标 U 盘或手动同步一次，结果会保存在这里。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Activities}"
                              Visibility="{Binding HasActivities, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="16,13"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="{Binding DateText}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TimeText}" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusTone}" Value="success">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusTone}" Value="error">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusTone}" Value="cancelled">
                                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Path Width="15"
                                                  Height="15"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.Check}"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource SuccessBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.8"
                                                  Visibility="{Binding Record.Success, Converter={StaticResource BoolToVis}}" />
                                            <Path Width="15"
                                                  Height="15"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.Alert}"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource DangerBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.7"
                                                  Visibility="{Binding Failed, Converter={StaticResource BoolToVis}}" />
                                            <Path Width="15"
                                                  Height="15"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.Clock}"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource WarningBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.7"
                                                  Visibility="{Binding Record.Cancelled, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SummaryText}" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="7,2"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    CornerRadius="8">
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           Text="{Binding TriggerText}" />
                                            </Border>
                                            <Border Margin="6,0,0,0"
                                                    Padding="7,2"
                                                    Background="{StaticResource WarningSoftBrush}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HasDeletions, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Text="{Binding DeletionText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="{Binding DeviceText}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Text="{Binding ErrorText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="{Binding MetaText}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="{Binding DetailText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="2,14,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource InkFaintBrush}"
                           Text="记录保存在本机的应用数据目录中，最多保留 60 条。清空记录不会删除 U 盘上的文件。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
