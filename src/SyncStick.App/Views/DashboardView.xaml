<UserControl x:Class="SyncStick.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncStick.App.Controls"
             Background="Transparent"
             FontFamily="{StaticResource Font.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <Grid MaxWidth="1080"
              Margin="32,20,30,24"
              HorizontalAlignment="Stretch">
            <StackPanel>

                <!-- ================================================= header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="SYNC DESK / 同步总览" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Text.Display}"
                                   Text="插上 U 盘，项目就位" />
                        <TextBlock MaxWidth="620"
                                   Margin="0,7,0,0"
                                   Style="{StaticResource Text.Body}"
                                   Text="选定要跟随的内容和一块外部存储设备。之后每次插入，SyncStick 都会把有变化的文件覆盖进去。"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="24,0,0,0"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="sources"
                                Style="{StaticResource GhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15"
                                      Height="15"
                                      Data="{StaticResource Icon.Folder}"
                                      Stroke="{StaticResource InkSoftBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform" />
                                <TextBlock Margin="7,0,0,0" Text="管理内容" />
                            </StackPanel>
                        </Button>
                        <Button Margin="10,0,0,0"
                                Command="{Binding PrimaryActionCommand}"
                                AutomationProperties.Name="{Binding PrimaryActionText}"
                                Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15"
                                      Height="15"
                                      Data="{StaticResource Icon.Sync}"
                                      Stroke="#FFF9F2"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.7"
                                      Stretch="Uniform" />
                                <TextBlock Margin="8,0,0,0"
                                           Foreground="#FFF9F2"
                                           Text="{Binding PrimaryActionText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- =================================================== hero -->
                <Border MinHeight="228"
                        Margin="0,16,0,0"
                        Background="{StaticResource HeroBrush}"
                        BorderBrush="{StaticResource HeroLineBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Effect="{StaticResource LiftedShadow}">
                    <Grid ClipToBounds="True">
                        <Border Background="{StaticResource HeroDotGrid}" CornerRadius="20" />

                        <Grid Margin="30,20,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="238" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Padding="11,5"
                                            Background="#16FFFFFF"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource HeroMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="ready">
                                                                <Setter Property="Fill" Value="#6FC99B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="done">
                                                                <Setter Property="Fill" Value="#6FC99B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="busy">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="error">
                                                                <Setter Property="Fill" Value="#FF8C7D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CreamBrush}"
                                                       Text="{Binding StatusBadge}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="9.5"
                                               Foreground="#7F8E82"
                                               Text="{Binding StatusKicker}" />
                                </StackPanel>

                                <TextBlock MaxWidth="560"
                                           Margin="0,18,0,0"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CreamBrush}"
                                           LineHeight="39"
                                           Text="{Binding Headline}"
                                           TextWrapping="Wrap" />

                                <TextBlock MaxWidth="545"
                                           Margin="0,9,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource HeroMutedBrush}"
                                           LineHeight="21"
                                           Text="{Binding StatusBody}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,12,0,0"
                                        Padding="9,4"
                                        HorizontalAlignment="Left"
                                        Background="#16FFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="#7F8E82"
                                                   Text="RULE" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   Text="{Binding ActiveRuleNameText}" />
                                        <TextBlock Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#7F8E82"
                                                   Text="{Binding ActiveRuleSummaryText}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,16,0,0"
                                            MaxWidth="520"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontFamily="{StaticResource Font.Mono}"
                                               FontSize="10.5"
                                               Foreground="#B9C4B9"
                                               Text="{Binding CurrentFileText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="4"
                                                 Margin="0,8,0,0"
                                                 Background="#25FFFFFF"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Maximum="100"
                                                 Style="{StaticResource Meter}"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9.5"
                                                   Foreground="#7F8E82"
                                                   Text="{Binding ProgressCounterText}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9.5"
                                                   Foreground="#7F8E82"
                                                   Text="{Binding ProgressBytesText}" />
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="#718176"
                                                   Text="SOURCES" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   Text="{Binding SourceCountText}" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="0,1,16,1"
                                            Background="#28FFFFFF" />

                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="#718176"
                                                   Text="AUTO SYNC" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   Text="{Binding AutoSyncStateText}" />
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            Margin="16,1,16,1"
                                            Background="#28FFFFFF" />

                                    <StackPanel Grid.Column="4" Margin="16,0,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="#718176"
                                                   Text="LAST SYNC" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   Text="{Binding LastSyncTimeText}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ring -->
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Width="184" Height="184">
                                    <Ellipse Width="184"
                                             Height="184"
                                             Stroke="#17FFFFFF"
                                             StrokeThickness="1" />
                                    <Ellipse Width="160"
                                             Height="160"
                                             Stroke="#0CFFFFFF"
                                             StrokeThickness="1" />
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,28,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource AccentBrush}"
                                             Opacity="0.85" />
                                    <controls:ProgressRing Width="150"
                                                           Height="150"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           DoneBrush="#6FC99B"
                                                           ErrorBrush="#FF8C7D"
                                                           RingBrush="{StaticResource AccentBrush}"
                                                           RingThickness="5"
                                                           State="{Binding RingState}"
                                                           TrackBrush="#26FFFFFF"
                                                           Value="{Binding ProgressPercent}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   Text="{Binding RingTitle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="#8C9B8E"
                                                   Text="{Binding RingSubtitle}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock MaxWidth="210"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="#77877B"
                                           Text="{Binding TargetLabel}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================================================== route -->
                <Border Margin="0,14,0,0"
                        Padding="20,15"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.H3}" Text="同步路径" />
                                <TextBlock Margin="10,3,0,0"
                                           Style="{StaticResource Text.Overline}"
                                           Text="ROUTE" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="sources"
                                    Style="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11.5" Text="编辑内容" />
                                    <Path Width="13"
                                          Height="13"
                                          Margin="6,0,0,0"
                                          Data="{StaticResource Icon.ChevronRight}"
                                          Stroke="{StaticResource InkSoftBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="13,11"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="10">
                                        <Path Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Folder}"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="01 / 来源" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding PathSourceValue}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="{Binding PathSourceSub}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Path Grid.Column="1"
                                  Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.ArrowRight}"
                                  Stroke="{StaticResource LineStrongBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform" />

                            <Border Grid.Column="2"
                                    Padding="13,11"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="10">
                                        <Path Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Sync}"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="02 / 规则" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding PathRuleValue}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="{Binding PathRuleSub}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Path Grid.Column="3"
                                  Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.ArrowRight}"
                                  Stroke="{StaticResource LineStrongBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform" />

                            <Border Grid.Column="4"
                                    Padding="13,11"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="10">
                                        <Path Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Usb}"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="03 / 目标" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding PathTargetValue}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="{Binding PathTargetSub}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================================================= bottom -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="20,15" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.H3}" Text="最近一次同步" />
                                    <TextBlock Margin="10,3,0,0"
                                               Style="{StaticResource Text.Overline}"
                                               Text="LAST RUN" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="activity"
                                        Style="{StaticResource GhostButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11.5" Text="全部记录" />
                                        <Path Width="13"
                                              Height="13"
                                              Margin="6,0,0,0"
                                              Data="{StaticResource Icon.ChevronRight}"
                                              Stroke="{StaticResource InkSoftBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5"
                                              Stretch="Uniform" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,15,0,0"
                                        Visibility="{Binding HasLastSync, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           Text="NO RUNS YET" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="还没有同步过" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="第一次写入后，这里会留下文件数量、体积和用时。"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,15,0,0"
                                  Visibility="{Binding HasLastSync, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38"
                                        Height="38"
                                        VerticalAlignment="Top"
                                        CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastSyncStatusTone}" Value="success">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastSyncStatusTone}" Value="error">
                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastSyncStatusTone}" Value="cancelled">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Path Width="17"
                                              Height="17"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Check}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource SuccessBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.8"
                                              Visibility="{Binding LastSyncWasSuccess, Converter={StaticResource BoolToVis}}" />
                                        <Path Width="17"
                                              Height="17"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Alert}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource DangerBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.7"
                                              Visibility="{Binding LastSyncFailed, Converter={StaticResource BoolToVis}}" />
                                        <Path Width="17"
                                              Height="17"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Clock}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource WarningBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.7"
                                              Visibility="{Binding LastSyncWasCancelled, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,16,0">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding LastSyncTitle}" />
                                    <TextBlock MaxWidth="400"
                                               Margin="0,4,0,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               LineHeight="18"
                                               Text="{Binding LastSyncSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="10"
                                               Foreground="{StaticResource InkFaintBrush}"
                                               Text="{Binding LastSyncDeviceText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="文件" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding LastSyncFilesText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="体积" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding LastSyncBytesText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="用时" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding LastSyncDurationText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="20,15" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.H3}" Text="最近活动" />
                                    <TextBlock Margin="10,3,0,0"
                                               Style="{StaticResource Text.Overline}"
                                               Text="FEED" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="activity"
                                        Style="{StaticResource GhostButton}"
                                        Content="全部"
                                        FontSize="11.5" />
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,15,0,0"
                                        Visibility="{Binding HasActivities, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           Text="QUIET IN HERE" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="暂无活动" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="插上 U 盘或手动同步一次，记录会出现在这里。"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1"
                                          Margin="0,8,0,0"
                                          ItemsSource="{Binding RecentActivities}"
                                          Visibility="{Binding HasActivities, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource InkFaintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="success">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="error">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="cancelled">
                                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource InkFaintBrush}"
                                                       Text="{Binding FeedTimeText}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="11.5"
                                                           Text="{Binding SummaryText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource InkFaintBrush}"
                                                           Text="{Binding DeviceText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
