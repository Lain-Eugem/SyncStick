<UserControl x:Class="SyncStick.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{StaticResource Font.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <Grid MaxWidth="1080"
              Margin="32,24,30,30"
              HorizontalAlignment="Stretch">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="TARGET / 目标设备" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Text.Display}"
                                   Text="选一块 U 盘作为落点" />
                        <TextBlock MaxWidth="620"
                                   Margin="0,7,0,0"
                                   Style="{StaticResource Text.Body}"
                                   Text="SyncStick 会记住这块设备，并在它插入时自动同步。换一个 USB 口、换一个盘符，都不会影响识别。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="24,0,0,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding RefreshDevicesCommand}"
                            Style="{StaticResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Data="{StaticResource Icon.Refresh}"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" />
                            <TextBlock Margin="7,0,0,0" Text="刷新设备" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- selected target -->
                <Border Margin="0,20,0,0"
                        Padding="22,20"
                        Style="{StaticResource CardBorder}"
                        Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="72"
                                Height="72"
                                VerticalAlignment="Top"
                                Background="{StaticResource InkBrush}"
                                CornerRadius="19">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CreamBrush}"
                                           Text="{Binding TargetLetterDisplay}" />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="8"
                                           Foreground="#8C9B8E"
                                           Text="TARGET" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="4,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Overline}" Text="CURRENT TARGET" />
                                <Border Margin="9,0,0,0"
                                        Padding="8,2"
                                        CornerRadius="9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetStatusTone}" Value="success">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TargetStatusTone}" Value="error">
                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource Font.Mono}"
                                               FontSize="8.5"
                                               Text="{Binding TargetStatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TargetStatusTone}" Value="success">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TargetStatusTone}" Value="error">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Text="{Binding TargetDisplayName}"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="容量" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding TargetCapacityDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="可用" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding TargetFreeDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="格式" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding TargetFileSystemDisplay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Overline}" Text="SERIAL" />
                                <TextBlock Margin="7,0,0,0"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="{Binding TargetSerialDisplay}" />
                                <Border Width="1" Height="10" Margin="12,0" Background="{StaticResource LineBrush}" />
                                <TextBlock Style="{StaticResource Text.Overline}" Text="ROOT" />
                                <TextBlock Margin="7,0,0,0"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="{Binding TargetRootPathDisplay}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                            <Button Command="{Binding PrimaryActionCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="{Binding TargetConnected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14"
                                          Height="14"
                                          Data="{StaticResource Icon.Sync}"
                                          Stroke="#FFF9F2"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.7"
                                          Stretch="Uniform" />
                                    <TextBlock Margin="7,0,0,0"
                                               Foreground="#FFF9F2"
                                               Text="{Binding PrimaryActionText}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0"
                                    Command="{Binding ClearTargetCommand}"
                                    Content="移除目标"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,20,0,0"
                        Padding="28,24"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding HasTarget, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="16">
                            <Path Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Usb}"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Text.H2}"
                                   Text="还没有选择目标设备" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Body}"
                                   Text="在下方选择一块 U 盘。之后每次插入，SyncStick 都会自动写入。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- removable devices -->
                <Grid Margin="0,24,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.H3}" Text="可移动设备" />
                        <TextBlock Margin="9,2,0,0"
                                   Style="{StaticResource Text.Overline}"
                                   Text="{Binding RemovableDeviceCountText}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Overline}"
                               Text="AUTO REFRESH · 1.2S" />
                </Grid>

                <Border Padding="26,23"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Visibility="{Binding HasNoRemovableDevices, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="11">
                            <Path Width="17"
                                  Height="17"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Info}"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="没有发现可移动设备" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       Text="插入 U 盘后会自动出现在这里。如果它是 USB 硬盘，可能被识别为固定磁盘。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshDevicesCommand}"
                                Content="重新扫描"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding RemovableDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="15,13"
                                    CornerRadius="14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Background" Value="#FFFCF8F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42"
                                            Height="42"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DriveLetter}" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="2,0,18,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Margin="8,1,0,0"
                                                    Padding="7,2"
                                                    Background="{StaticResource SuccessSoftBrush}"
                                                    CornerRadius="8">
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Text="{Binding KindBadge}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="{Binding MetaText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Margin="0,0,18,0"
                                                VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Style="{StaticResource Text.Overline}" Text="设备容量" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource InkFaintBrush}"
                                                           Text="已用 " />
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource InkFaintBrush}"
                                                           Text="{Binding UsedPercent, StringFormat={}{0:0}%}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Maximum="100"
                                                     Style="{StaticResource Meter}"
                                                     Value="{Binding UsedPercent, Mode=OneWay}" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            MinWidth="88"
                                            VerticalAlignment="Center"
                                            Command="{Binding SelectCommand}"
                                            Content="{Binding ActionText}"
                                            IsEnabled="{Binding IsNotTarget}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- fixed drives -->
                <Border Margin="0,10,0,0"
                        Padding="15,13"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Visibility="{Binding ShowAdvancedToggle, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="显示其他驱动器" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       Text="USB 移动硬盘和固态硬盘可能被 Windows 标记为固定磁盘。仅在确认安全时使用。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton AutomationProperties.Name="显示其他驱动器" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowFixedDrives, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <StackPanel Visibility="{Binding ShowFixedSection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Margin="0,16,0,8"
                               Style="{StaticResource Text.Overline}"
                               Text="FIXED / 其他驱动器" />
                    <ItemsControl ItemsSource="{Binding FixedDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="15,13"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42"
                                                Height="42"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DriveLetter}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="2,0,18,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Margin="8,1,0,0"
                                                        Padding="7,2"
                                                        Background="{StaticResource WarningSoftBrush}"
                                                        CornerRadius="8">
                                                    <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="8"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               Text="固定磁盘" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource InkFaintBrush}"
                                                       Text="{Binding MetaText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="88"
                                                VerticalAlignment="Center"
                                                Command="{Binding SelectCommand}"
                                                Content="{Binding ActionText}"
                                                IsEnabled="{Binding IsNotTarget}"
                                                Style="{StaticResource SecondaryButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Margin="0,14,0,0"
                        Padding="16,13"
                        Background="{StaticResource SurfaceHoverBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              VerticalAlignment="Top"
                              Data="{StaticResource Icon.Shield}"
                              Stroke="{StaticResource InkFaintBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5"
                              Stretch="Uniform" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   LineHeight="18"
                                   Text="SyncStick 通过卷序列号记住设备，不需要管理员权限，也不会读取 U 盘内容清单以外的信息。格式化 U 盘会改变序列号，需要重新选择。"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
