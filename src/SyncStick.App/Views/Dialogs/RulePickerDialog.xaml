<Window x:Class="SyncStick.App.Views.Dialogs.RulePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncStick"
        Width="500"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Body}">

    <Window.Resources>
        <Style x:Key="RuleOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Margin="0,0,0,8"
                                Padding="14,11"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="26"
            Padding="24,22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource LiftedShadow}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="12">
                    <Path Width="18"
                          Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.Folder}"
                          Stretch="Uniform"
                          Stroke="{StaticResource AccentDeepBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.6" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Style="{StaticResource Text.H2}"
                               Text="选择要同步的规则"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Overline}"
                               Text="SYNCSTICK / RULES" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Click="OnCancel"
                        Style="{StaticResource IconButton}"
                        ToolTip="关闭">
                    <Path Width="13"
                          Height="13"
                          Data="{StaticResource Icon.Close}"
                          Stretch="Uniform"
                          Stroke="{StaticResource InkFaintBrush}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.6" />
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Margin="0,16,0,0"
                       FontSize="12.5"
                       Foreground="{StaticResource InkSoftBrush}"
                       LineHeight="20"
                       Text="选择后立即用这个规则同步。下次插入这块设备时，会默认选中上次使用的规则。"
                       TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="340"
                          Margin="0,14,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="RulePick"
                                         Style="{StaticResource RuleOption}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SuccessSoftBrush}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Text="{Binding ActiveBadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Text="{Binding DetailText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="10"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="{Binding CountText}" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.Overline}"
                           Text="PICK A RULE" />

                <Button Grid.Column="1"
                        MinWidth="82"
                        Click="OnCancel"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />

                <Button x:Name="ConfirmButton"
                        Grid.Column="3"
                        MinWidth="120"
                        Click="OnConfirm"
                        Content="用此规则同步"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
