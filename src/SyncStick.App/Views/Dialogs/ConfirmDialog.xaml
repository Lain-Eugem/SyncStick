<Window x:Class="SyncStick.App.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncStick"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Body}">

    <Border Margin="26"
            Padding="24,22"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource LiftedShadow}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DialogIconBorder"
                        Width="38"
                        Height="38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource WarningSoftBrush}"
                        CornerRadius="12">
                    <Path x:Name="DialogIconPath"
                          Width="18"
                          Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.Alert}"
                          Stretch="Uniform"
                          Stroke="{StaticResource WarningBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.7" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.H2}"
                               Text="确认操作"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="KickerText"
                               Margin="0,4,0,0"
                               Style="{StaticResource Text.Overline}"
                               Text="SYNCSTICK / CONFIRM" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Click="OnCancel"
                        Style="{StaticResource IconButton}"
                        ToolTip="关闭">
                    <Path Width="13"
                          Height="13"
                          Data="{StaticResource Icon.Close}"
                          Stretch="Uniform"
                          Stroke="{StaticResource InkFaintBrush}"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.6" />
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Margin="0,20,0,0"
                       FontSize="13"
                       Foreground="{StaticResource InkSoftBrush}"
                       LineHeight="22"
                       TextWrapping="Wrap" />

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.Overline}"
                           Text="CHANGES ARE LOCAL" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        MinWidth="82"
                        Click="OnCancel"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />

                <Button x:Name="ConfirmButton"
                        Grid.Column="3"
                        MinWidth="104"
                        Click="OnConfirm"
                        Content="确定"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
