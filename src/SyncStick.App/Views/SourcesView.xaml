<UserControl x:Class="SyncStick.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Background="Transparent"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Drop="OnDrop"
             FontFamily="{StaticResource Font.Body}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <Grid MaxWidth="1080"
                  Margin="32,24,30,30"
                  HorizontalAlignment="Stretch">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Overline}" Text="SOURCES / 同步内容" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Text.Display}"
                                       Text="决定 U 盘里放什么" />
                            <TextBlock MaxWidth="600"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource Text.Body}"
                                       Text="可以添加多个文件或文件夹。文件夹会保留原目录结构；U 盘上的同名文件会被新版本覆盖。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal">
                            <Button Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15"
                                          Height="15"
                                          Data="{StaticResource Icon.FilePlus}"
                                          Stroke="{StaticResource InkSoftBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform" />
                                    <TextBlock Margin="7,0,0,0" Text="添加文件" />
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0"
                                    Command="{Binding AddFolderCommand}"
                                    Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15"
                                          Height="15"
                                          Data="{StaticResource Icon.FolderPlus}"
                                          Stroke="#FFF9F2"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Uniform" />
                                    <TextBlock Margin="7,0,0,0" Foreground="#FFF9F2" Text="添加文件夹" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,20,0,0"
                            Padding="15,13"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SuccessSoftBrush}"
                                    CornerRadius="9">
                                <Path Width="15"
                                      Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.Shield}"
                                      Stroke="{StaticResource SuccessBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       LineHeight="18"
                                       Text="只写入你选中的内容。默认保留目录结构，并覆盖有变化的同名文件；不会删除 U 盘上的其他文件。"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- empty state -->
                    <Border Margin="0,18,0,0"
                            Padding="30"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="{Binding HasAnySources, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="58"
                                    Height="58"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="17">
                                <Path Width="25"
                                      Height="25"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.FolderPlus}"
                                      Stroke="{StaticResource InkSoftBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.4"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Text.H2}"
                                       Text="还没有同步内容" />
                            <TextBlock MaxWidth="380"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource Text.Body}"
                                       Text="先选一个项目文件夹，或几个常用文件。选中后就会出现在这里。"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,18,0,8"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button Command="{Binding AddFolderCommand}"
                                        Content="添加文件夹"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Margin="10,0,0,0"
                                        Command="{Binding AddFilesCommand}"
                                        Content="添加文件"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- list -->
                    <StackPanel Visibility="{Binding HasAnySources, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,22,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.H3}" Text="同步项" />
                                <Border Margin="9,1,0,0"
                                        Padding="8,2"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="10">
                                    <TextBlock FontFamily="{StaticResource Font.Mono}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="{Binding SourcePageSummary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Overline}"
                                       Text="拖入文件也可以添加" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9"
                                            Padding="15,13"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="268" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton AutomationProperties.Name="启用或暂停这个同步项" HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          ToolTip="启用或暂停这一项" />

                                            <Border Grid.Column="1"
                                                    Width="38"
                                                    Height="38"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    CornerRadius="11">
                                                <Path Width="18"
                                                      Height="18"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{Binding Icon}"
                                                      Stroke="{StaticResource InkBrush}"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.5"
                                                      Stretch="Uniform" />
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        Margin="10,0,18,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock MaxWidth="330"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Margin="8,1,0,0"
                                                            Padding="7,2"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="9">
                                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                                   FontSize="8.5"
                                                                   Foreground="{StaticResource InkSoftBrush}"
                                                                   Text="{Binding MetaText}" />
                                                    </Border>
                                                    <Border Margin="7,1,0,0"
                                                            Padding="7,2"
                                                            Background="{StaticResource DangerSoftBrush}"
                                                            CornerRadius="9"
                                                            Visibility="{Binding HasPathError, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                                   FontSize="8.5"
                                                                   Foreground="{StaticResource DangerBrush}"
                                                                   Text="路径不存在" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,4,0,0"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource InkFaintBrush}"
                                                           Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,0,4"
                                                           Style="{StaticResource Text.Overline}"
                                                           Text="U 盘内位置" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Name="DestinationBox"
                                                             Grid.Column="0"
                                                             Padding="9,0,28,0"
                                                             Style="{StaticResource FieldTextBox}"
                                                             Text="{Binding DestinationSubfolder, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="留空表示使用默认位置。文件夹默认以自己的名字命名；文件默认放在 U 盘根目录。也可以点右侧文件夹按钮直接在 U 盘上选择。" />
                                                    <TextBlock Grid.Column="0"
                                                               Margin="10,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource InkFaintBrush}"
                                                               IsHitTestVisible="False"
                                                               Text="{Binding DestinationPlaceholder}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=DestinationBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Grid.Column="1"
                                                            Width="30"
                                                            Height="30"
                                                            Margin="4,0,0,0"
                                                            AutomationProperties.Name="选择 U 盘内的写入文件夹"
                                                            Command="{Binding BrowseDestinationCommand}"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="在 U 盘上选择写入文件夹">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Data="{StaticResource Icon.Folder}"
                                                              Stroke="{StaticResource InkSoftBrush}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5"
                                                              Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Margin="1,4,0,0"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="9"
                                                           Text="{Binding DestinationHint}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDestinationError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Button Command="{Binding RevealCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="在资源管理器中打开">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="{StaticResource Icon.External}"
                                                          Stroke="{StaticResource InkFaintBrush}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.5"
                                                          Stretch="Uniform" />
                                                </Button>
                                                <Button Margin="2,0,0,0"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="从同步内容中移除">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="{StaticResource Icon.Trash}"
                                                          Stroke="{StaticResource InkFaintBrush}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.5"
                                                          Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,3,0,0"
                                Padding="16,15"
                                Background="{StaticResource SurfaceHoverBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30"
                                            Height="30"
                                            Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="9">
                                        <Path Width="15"
                                              Height="15"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource Icon.Plus}"
                                              Stroke="{StaticResource InkSoftBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.6"
                                              Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="继续添加" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="也可以直接把文件或文件夹拖进这个窗口。" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding AddFilesCommand}"
                                            Content="添加文件"
                                            Style="{StaticResource GhostButton}" />
                                    <Button Margin="4,0,0,0"
                                            Command="{Binding AddFolderCommand}"
                                            Content="添加文件夹"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,14,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource InkFaintBrush}"
                                   Text="提示：每一行的“U 盘内位置”是相对 U 盘根目录的路径，点右侧文件夹按钮可以直接在 U 盘上选择。留空时，文件夹以自己的名字命名，文件直接放在根目录。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- drop overlay -->
        <Border Margin="24"
                Background="#EDF3F0E7"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="20"
                IsHitTestVisible="False"
                Visibility="{Binding IsDropActive, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="18">
                    <Path Width="26"
                          Height="26"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.FolderPlus}"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.6"
                          Stretch="Uniform" />
                </Border>
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.H2}"
                           Text="松开即可添加" />
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Small}"
                           Text="文件与文件夹都可以" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
