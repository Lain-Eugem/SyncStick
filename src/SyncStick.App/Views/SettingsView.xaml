<UserControl x:Class="SyncStick.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{StaticResource Font.Body}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <Grid MaxWidth="1080"
              Margin="32,24,30,30"
              HorizontalAlignment="Stretch">
            <StackPanel>

                <TextBlock Style="{StaticResource Text.Overline}" Text="SETTINGS / 设置" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource Text.Display}"
                           Text="调成你的节奏" />
                <TextBlock MaxWidth="620"
                           Margin="0,7,0,0"
                           Style="{StaticResource Text.Body}"
                           Text="同步规则、启动方式与通知都在这里。所有设置只保存在本机。"
                           TextWrapping="Wrap" />

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Padding="20,18" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.H3}" Text="同步行为" />
                                    <TextBlock Margin="10,3,0,0"
                                               Style="{StaticResource Text.Overline}"
                                               Text="WRITE RULES" />
                                </StackPanel>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="智能覆盖" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="只复制新增或已变化的文件；同名的旧文件会被覆盖。关闭后会每次全部重写。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="智能覆盖" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding SmartOverwrite, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="复制时间戳" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="保留来源文件的修改时间，方便在 U 盘上识别版本。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="复制时间戳" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding CopyTimestamps, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="忽略系统临时文件" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="跳过 Thumbs.db、desktop.ini、~$ 临时文档等系统文件。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="忽略系统临时文件" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IgnoreSystemFiles, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,16,0,0"
                                        Padding="13,12"
                                        Background="{StaticResource DangerSoftBrush}"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Data="{StaticResource Icon.Alert}"
                                                      Stroke="{StaticResource DangerBrush}"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.6"
                                                      Stretch="Uniform" />
                                                <TextBlock Margin="6,0,0,0"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Text="镜像清理" />
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0"
                                                       FontSize="10.5"
                                                       Foreground="#8A4A43"
                                                       LineHeight="17"
                                                       Text="成功同步后，删除所选文件夹在 U 盘内对应目录中的多余文件。请确认每一项的“U 盘内位置”。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleButton AutomationProperties.Name="镜像清理" Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MirrorDelete, Mode=TwoWay}"
                                                      Style="{StaticResource ToggleSwitch}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="20,18" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.H3}" Text="数据与隐私" />
                                    <TextBlock Margin="10,3,0,0"
                                               Style="{StaticResource Text.Overline}"
                                               Text="LOCAL DATA" />
                                </StackPanel>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource Text.Label}"
                                           Text="数据目录" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="{Binding DataDirectoryText}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                    <Button Command="{Binding OpenDataFolderCommand}"
                                            Content="打开数据目录"
                                            Style="{StaticResource SecondaryButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding ClearActivitiesCommand}"
                                            Content="清空活动记录"
                                            Style="{StaticResource GhostButton}" />
                                </StackPanel>

                                <Border Margin="0,14,0,0"
                                        Padding="12,10"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        CornerRadius="9">
                                    <TextBlock FontSize="10.5"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               LineHeight="17"
                                               Text="SyncStick 不联网、不上传文件。配置与活动记录仅保存在本机。移除目标设备不会修改 U 盘内容。"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Padding="20,18" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.H3}" Text="自动与启动" />
                                    <TextBlock Margin="10,3,0,0"
                                               Style="{StaticResource Text.Overline}"
                                               Text="AUTOMATION" />
                                </StackPanel>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="插入后自动同步" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="检测到目标设备接入后，等待片刻再开始写入。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="插入后自动同步" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="启动时同步已连接的设备" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="如果打开应用时目标 U 盘已经插着，也自动同步一次。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="启动时同步已连接的设备" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoSyncOnLaunch, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="开机自动启动" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="登录 Windows 后在托盘静默启动。优先写入当前用户启动项，被拦截时改用启动文件夹快捷方式；图标若没出现，点右下角 ^ 展开。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="开机自动启动" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="关闭窗口时最小化到托盘" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="关闭主窗口后继续在后台监听；从托盘菜单可以彻底退出。Windows 11 可能会把新图标收进任务栏右下角的 ^ 里。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="关闭窗口时最小化到托盘" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="完成时发送通知" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="同步结束后显示桌面通知；失败时仍会保留活动记录。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton AutomationProperties.Name="完成时发送通知" Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding NotifyOnComplete, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="20,18" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="46"
                                           Height="46"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="pack://application:,,,/Assets/syncstick.png" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource Font.Display}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       Text="SyncStick" />
                                            <TextBlock Margin="8,4,0,0"
                                                       Style="{StaticResource Text.Overline}"
                                                       Text="{Binding AppVersionText}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Text="把需要的项目，随 U 盘一起带走。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,14,0,0" Style="{StaticResource Hairline}" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           LineHeight="18"
                                           Text="Windows 10 / 11 · WPF / .NET 10 单文件应用&#10;本机运行 · 不上传文件 · 不需要管理员权限"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
